{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hustlero-hcs-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "development",
  },
  "observability": {
    "enabled": true,
  },
  "env": {
    "development": {
      "name": "hustlero-hcs-api-development",
      "vars": {
        "ENVIRONMENT": "development",
        "SUPABASE_URL": "https://nlrzdgcxydmcvhushzwv.supabase.co",
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "0a57f9065dea4b159b7ef2cad9ca3e80",
        },
      ],
    },
    "staging": {
      "name": "hustlero-hcs-api-staging",
      "vars": {
        "ENVIRONMENT": "staging",
      },
    },
    "production": {
      "name": "hustlero-hcs-api",
      "vars": {
        "ENVIRONMENT": "production",
      },
    },
  },
}
