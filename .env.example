# Public browser configuration. Values are placeholders only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8787

# Server-only Supabase configuration. Never expose these in a browser bundle.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
DATABASE_URL=
DATABASE_DIRECT_URL=

# Cloudflare bindings are configured in each app's future wrangler.jsonc.
ENVIRONMENT=development
APP_BASE_URL=http://localhost:3000
BACKOFFICE_BASE_URL=http://localhost:3001
POS_BASE_URL=http://localhost:3002
ADMIN_BASE_URL=http://localhost:3003
API_BASE_URL=http://localhost:8787

# Optional integrations. Leave unset until the corresponding module is approved.
SENTRY_DSN=
EMAIL_PROVIDER_API_KEY=
SUBSCRIPTION_PROVIDER_SECRET=
